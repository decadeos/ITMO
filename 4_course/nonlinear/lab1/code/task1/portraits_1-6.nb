Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"x1", "^", "3"}]}], "+", 
    RowBox[{"x2", "^", "3"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"x2", "^", "3"}], "*", "x1"}], "-", 
     RowBox[{"x2", "^", "3"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
