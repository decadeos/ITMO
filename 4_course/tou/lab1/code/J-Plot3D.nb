 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "10"}], ",", " ", "7"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"history", " ", "=", " ", 
    RowBox[{"{", "x0", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gamma", " ", "=", " ", "0.05"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gradNorm", "=", 
   RowBox[{"Norm", "[", 
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"x", ",", "u"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "u"}], "}"}]}], "]"}], "/.", 
     RowBox[{"{", 
