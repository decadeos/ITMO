       RowBox[{"x", "\[Rule]", 
        RowBox[{"x0", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"u", "\[Rule]", 
        RowBox[{"x0", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tol", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"i", "\[LessEqual]", "500"}], " ", "&&", " ", 
     RowBox[{"gradNorm", ">", "tol"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gradNum", "=", 
      RowBox[{
       RowBox[{"Grad", "[", 
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"x", ",", "u"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "u"}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "\[Rule]", 
          RowBox[{"x0", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"u", "\[Rule]", 
          RowBox[{"x0", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xNew", " ", "=", " ", 
      RowBox[{"x0", "  ", "-", " ", 
       RowBox[{"gamma", " ", "*", "gradNum"}]}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"x0", " ", "=", " ", "xNew"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"history", ",", "x0"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
