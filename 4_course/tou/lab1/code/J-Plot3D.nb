Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"x_", ",", "u_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"6", 
     SuperscriptBox["x", "2"]}], "+", 
    SuperscriptBox["u", "2"], "+", 
    RowBox[{"4", "x", " ", "u"}], "+", 
    RowBox[{"3", "x"}], "+", 
    RowBox[{"4", "u"}], "-", "9"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessJ", " ", "=", " ", 
