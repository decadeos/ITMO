  RowBox[{"J", "[", 
   RowBox[{"x_", ",", "u_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"6", 
    SuperscriptBox["x", "2"]}], "+", 
   SuperscriptBox["u", "2"], "+", 
   RowBox[{"4", "x", " ", "u"}], "+", 
   RowBox[{"3", "x"}], "+", 
   RowBox[{"4", "u"}], "-", "9"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "[", 
   RowBox[{"x_", ",", "u_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"3", "x"}], " ", "+", 
   RowBox[{"4", 
    SuperscriptBox["u", "2"]}], " ", "+", "7"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xConstr", "[", "u_", "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", 
         RowBox[{"u", "^", "2"}]}], "+", "7"}], ")"}]}], "/", "3"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"surf", " ", "=", " ", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"J", "[", 
       RowBox[{"x", ",", "u"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", 
        RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AxesLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", "\"\<u\>\"", ",", "\"\<J\>\""}], "}"}]}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontFamily", "\[Rule]", "\"\<Cambria Math\>\""}], ",", 
         RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ColorFunction", "\[Rule]", "\"\<Rainbow\>\""}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"BarLegend", "[", 
        RowBox[{"Automatic", ",", "\[IndentingNewLine]", 
         RowBox[{"LabelStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FontFamily", "\[Rule]", "\"\<Cambria Math\>\""}], ",", 
            RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
         RowBox[{"LegendLabel", "\[Rule]", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<J(x,u)\>\"", ",", 
            RowBox[{"FontFamily", "\[Rule]", "\"\<Cambria Math\>\""}], ",", 
            "14"}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"line", "=", 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xConstr", "[", "u", "]"}], ",", "u", ",", 
        RowBox[{"J", "[", 
         RowBox[{
          RowBox[{"xConstr", "[", "u", "]"}], ",", "u"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", 
        RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Red", ",", " ", 
         RowBox[{"Thickness", "[", "0.009", "]"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ptMin", "=", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"{", 
      RowBox[{"Black", ",", 
       RowBox[{"PointSize", "[", "0.03", "]"}], ",", 
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2.342"}], ",", "0.0788", ",", 
          RowBox[{"J", "[", 
           RowBox[{
            RowBox[{"-", "2.342"}], ",", "0.0788"}], "]"}]}], "}"}], "]"}]}], 
      "}"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jeqplot", " ", "=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
    "surf", ",", "line", ",", " ", "ptMin", ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Epilog", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Inset", "[", 
        RowBox[{
         RowBox[{"Framed", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<\[FilledCircle] (\!\(\*SuperscriptBox[\(x\), \(*\)]\), \
\!\(\*SuperscriptBox[\(u\), \(*\)]\))\>\"", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Cambria Math\>\""}], ",", 
             "14", ",", "Black"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Background", "\[Rule]", "White"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"FrameStyle", "\[Rule]", "None"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"RoundingRadius", "\[Rule]", "2"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Scaled", "[", 
          RowBox[{"{", 
           RowBox[{"0.9", ",", "0.9"}], "}"}], "]"}]}], "\[IndentingNewLine]",
         "]"}], "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "SetDirectory", "[", 
   "\"\</home/eva/Documents/ITMO/4_course/tou/lab1/code\>\"", "]"}], 
