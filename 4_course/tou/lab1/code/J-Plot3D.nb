Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"x_", ",", "u_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"6", 
     SuperscriptBox["x", "2"]}], "+", 
    SuperscriptBox["u", "2"], "+", 
    RowBox[{"4", "x", " ", "u"}], "+", 
    RowBox[{"3", "x"}], "+", 
    RowBox[{"4", "u"}], "-", "9"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessJ", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"12", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "2"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "10"}], ",", " ", "7"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"history", " ", "=", " ", 
    RowBox[{"{", "x0", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gamma", " ", "=", " ", "0.12"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"gradNorm", "=", 
   RowBox[{"Norm", "[", 
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{"J", "[", 
        RowBox[{"x", ",", "u"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "u"}], "}"}]}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "\[Rule]", 
        RowBox[{"x0", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"u", "\[Rule]", 
        RowBox[{"x0", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tol", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"i", "\[LessEqual]", "500"}], " ", "&&", " ", 
     RowBox[{"gradNorm", ">", "tol"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gradNum", "=", 
      RowBox[{
       RowBox[{"Grad", "[", 
        RowBox[{
         RowBox[{"J", "[", 
          RowBox[{"x", ",", "u"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "u"}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "\[Rule]", 
          RowBox[{"x0", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"u", "\[Rule]", 
          RowBox[{"x0", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"xNew", " ", "=", " ", 
      RowBox[{"x0", "  ", "-", " ", 
       RowBox[{"gamma", " ", "*", "gradNum"}]}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"x0", " ", "=", " ", "xNew"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"history", ",", "x0"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"gradNorm", "=", 
      RowBox[{"Norm", "[", "gradNum", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"i", "++"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jGamma012", " ", "=", " ", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"J", "[", 
      RowBox[{"x", ",", " ", "u"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
