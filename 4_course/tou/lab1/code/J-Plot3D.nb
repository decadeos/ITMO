Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"x_", ",", "u_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"6", 
     SuperscriptBox["x", "2"]}], "+", 
    SuperscriptBox["u", "2"], "+", 
    RowBox[{"4", "x", " ", "u"}], "+", 
    RowBox[{"3", "x"}], "+", 
    RowBox[{"4", "u"}], "-", "9"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jplot", " ", "=", " ", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"J", "[", 
      RowBox[{"x", ",", "u"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<u\>\"", ",", "\"\<J\>\""}], "}"}]}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"LabelStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FontFamily", "\[Rule]", "\"\<Cambria Math\>\""}], ",", 
        RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ColorFunction", "\[Rule]", "\"\<Rainbow\>\""}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"BarLegend", "[", 
       RowBox[{"Automatic", ",", "\[IndentingNewLine]", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FontFamily", "\[Rule]", "\"\<Cambria Math\>\""}], ",", 
           RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
        RowBox[{"LegendLabel", "\[Rule]", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<J(x,u) = 6\!\(\*SuperscriptBox[\(x\), \
\(2\)]\)+\!\(\*SuperscriptBox[\(u\), \(2\)]\)+4xu+3x+4u-9\>\"", ",", 
           RowBox[{"FontFamily", "\[Rule]", "\"\<Cambria Math\>\""}], ",", 
           "14"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\n", 
