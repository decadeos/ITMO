Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"img", "=", 
    RowBox[{
    "Import", "[", 
     "\"\</home/eva/Documents/ITMO/2_course/chMetods/lab6/images/10.png\>\"", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rgbData", "=", 
    RowBox[{
     RowBox[{"ImageData", "[", 
      RowBox[{"img", ",", "\"\<Real\>\""}], "]"}], " ", "/", " ", "255"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fourierChannels", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Fourier", "[", 
      RowBox[{
       RowBox[{"rgbData", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "3"}], "}"}]}], " ", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fftshift", "[", "data_", "]"}], ":=", 
   RowBox[{"RotateRight", "[", 
    RowBox[{"data", ",", 
     RowBox[{"Floor", "[", 
      RowBox[{
       RowBox[{"Dimensions", "[", "data", "]"}], "/", "2"}], "]"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"shiftedFourier", "=", 
    RowBox[{"fftshift", "/@", "fourierChannels"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"amplitudeChannels", "=", 
   RowBox[{"Abs", "/@", "shiftedFourier"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phaseChannels", "=", 
    RowBox[{"Arg", "/@", "shiftedFourier"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logAmplitudeChannels", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", "#"}], "]"}], "&"}], "/@", "amplitudeChannels"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizedLogAmplitude", "=", 
    RowBox[{"Rescale", "/@", "logAmplitudeChannels"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colorFourier", "=", 
    RowBox[{"ColorCombine", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Image", "[", 
         RowBox[{"normalizedLogAmplitude", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
        RowBox[{"Image", "[", 
         RowBox[{"normalizedLogAmplitude", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
        RowBox[{"Image", "[", 
         RowBox[{"normalizedLogAmplitude", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "}"}], ",", 
      "\"\<RGB\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
   "\"\</home/eva/Documents/ITMO/2_course/chMetods/lab6/images/norm10.png\>\"\
", ",", "colorFourier"}], "]"}], ";"}], "\[IndentingNewLine]"}], "Input",
