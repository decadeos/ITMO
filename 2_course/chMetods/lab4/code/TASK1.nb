  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uVals", "=", 
    RowBox[{"gVals", "+", 
     RowBox[{"b", "*", "xi"}], "+", 
     RowBox[{"c", "*", 
