 RowBox[{
  RowBox[{"T", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dt", "=", "0.001"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tValues", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "T"}], "/", "2"}], ",", 
     RowBox[{"T", "/", "2"}], ",", "dt"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"Length", "[", "tValues", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gVals", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t1", "<=", "t", "<=", "t2"}], ",", "a", ",", "0"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xi", "=", 
