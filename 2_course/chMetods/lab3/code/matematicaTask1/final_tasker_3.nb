Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t1", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2", "=", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d", "=", "15"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "=", "0.5"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dt", "=", "0.001"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tValues", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "T"}], "/", "2"}], ",", 
     RowBox[{"T", "/", "2"}], ",", "dt"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"Length", "[", "tValues", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vValues", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "dt"}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}], "*", 
        RowBox[{"1", "/", "T"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gVals", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t1", "<=", "t", "<=", "t2"}], ",", "a", ",", "0"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xi", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "n"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uVals", "=", 
    RowBox[{"gVals", "+", 
     RowBox[{"b", "*", "xi"}], "+", 
     RowBox[{"c", "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"d", "*", "tValues"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
