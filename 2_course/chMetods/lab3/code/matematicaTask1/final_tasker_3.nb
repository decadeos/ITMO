Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"U", "=", 
   RowBox[{"Fourier", "[", 
    RowBox[{"uVals", ",", 
     RowBox[{"FourierParameters", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ushifted", "=", 
    RowBox[{"RotateLeft", "[", 
     RowBox[{"U", ",", 
      RowBox[{"Floor", "[", 
       RowBox[{"n", "/", "2"}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"notchWidthAroundZero", "=", "0.0"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroAroundZeroMask", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"f", "-", "v"}], "]"}], "<", "notchWidthAroundZero"}], ",", 
        "0", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"f", ",", "vValues"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Ufiltered", "=", 
   RowBox[{"Ushifted", "*", "zeroAroundZeroMask"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"UfilteredBack", "=", 
   RowBox[{"RotateRight", "[", 
    RowBox[{"Ufiltered", ",", 
     RowBox[{"Floor", "[", 
      RowBox[{"n", "/", "2"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uFilteredVals", "=", 
    RowBox[{"InverseFourier", "[", 
     RowBox[{"UfilteredBack", ",", 
      RowBox[{"FourierParameters", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
