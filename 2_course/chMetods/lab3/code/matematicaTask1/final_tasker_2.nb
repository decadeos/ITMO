        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"f", "-", "harmFreq"}], "]"}], "<", "notchWidth"}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"f", "+", "harmFreq"}], "]"}], "<", "notchWidth"}]}], ",", 
       "0", ",", "1"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"f", ",", "vValues"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"combinedMask", "=", 
    RowBox[{"lowPassMask", "*", "notchMask"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Ufiltered", "=", 
   RowBox[{"Ushifted", "*", "combinedMask"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"UfilteredBack", "=", 
   RowBox[{"RotateRight", "[", 
    RowBox[{"Ufiltered", ",", 
     RowBox[{"Floor", "[", 
      RowBox[{"n", "/", "2"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uFilteredVals", "=", 
    RowBox[{"InverseFourier", "[", 
     RowBox[{"UfilteredBack", ",", 
      RowBox[{"FourierParameters", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
