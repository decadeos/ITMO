  RowBox[{"n", "=", "100"}], ";", 
  RowBox[{"dx", "=", 
   RowBox[{"1.", "/", 
    RowBox[{"(", 
     RowBox[{"n", "-", "1"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"UnitStep", "[", 
