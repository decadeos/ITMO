         RowBox[{"-", "100"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "x"}], ")"}], "^", "2"}]}], "]"}]}], "]"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1", ",", "dx"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
