Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fourierFilter", "[", 
    RowBox[{"u_", ",", 
     RowBox[{"{", 
      RowBox[{"t_", ",", "tmin_", ",", "tmax_"}], "}"}], ",", "sampleRate_", 
     ",", "v0_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "timeValues", ",", "signalValues", ",", "fftValues", ",", "freqRange", 
       ",", "freqStep", ",", "freqValues", ",", "filteredFFT", ",", 
       "filteredSignal"}], "}"}], ",", 
     RowBox[{
      RowBox[{"timeValues", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"tmin", ",", "tmax", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"tmax", "-", "tmin"}], ")"}], "*", "sampleRate"}], "-", 
          "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"signalValues", "=", 
       RowBox[{"u", "/@", "timeValues"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fftValues", "=", 
       RowBox[{"Fourier", "[", 
        RowBox[{"signalValues", ",", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"freqRange", "=", 
       RowBox[{"Length", "[", "fftValues", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"freqStep", "=", 
       RowBox[{"sampleRate", "/", "freqRange"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"freqValues", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}], "*", 
          RowBox[{"sampleRate", "/", "freqRange"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "freqRange"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"freqValues", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", ">", 
            RowBox[{"sampleRate", "/", "2"}]}], ",", 
           RowBox[{"#", "-", "sampleRate"}], ",", "#"}], "]"}], "&"}], "/@", 
        "freqValues"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"filteredFFT", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "#2", "]"}], "<=", "v0"}], ",", "#1", ",", 
            "0"}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"fftValues", ",", "freqValues"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"filteredSignal", "=", 
       RowBox[{"InverseFourier", "[", 
        RowBox[{"filteredFFT", ",", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"timeValues", ",", 
        RowBox[{"Re", "[", "filteredSignal", "]"}]}], "}"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"times", ",", "filtered"}], "}"}], "=", 
