   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T", "=", "20"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dt", "=", "0.001"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "T"}], "/", "2"}], ",", 
       RowBox[{"T", "/", "2"}], ",", "dt"}], "]"}]}], ";"}], "\n", 
