                RowBox[{
                 RowBox[{"UnitVector", "[", 
                  RowBox[{"n", ",", "i"}], "]"}], "+", 
                 RowBox[{"UnitVector", "[", 
                  RowBox[{"n", ",", "j"}], "]"}]}], ")"}]}]}], "]"}]}], ")"}],
           "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", 
            RowBox[{"h", "^", "2"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hessian", "=", 
       RowBox[{"NumericalHessian", "[", "x", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
