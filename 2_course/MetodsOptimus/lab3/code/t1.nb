Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"returnFunc", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"aRand", ",", "aSum", ",", "A", ",", "b"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aRand", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aSum", "=", " ", 
       FractionBox[
        RowBox[{"aRand", "+", 
         RowBox[{"Transpose", "[", "aRand", "]"}]}], "2"]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A", "=", 
       RowBox[{"aSum", "+", 
        RowBox[{"3", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"10", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Function", "[", 
       RowBox[{"vec", ",", 
        RowBox[{
         FractionBox["1", "2"], "+", 
         RowBox[{
          RowBox[{"Transpose", "[", "vec", "]"}], ".", "A", ".", "vec"}], "-", 
         RowBox[{"b", ".", "vec"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotN", "=", "100"}], ";"}], "\[IndentingNewLine]", " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "=", 
    RowBox[{"returnFunc", "[", "n", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"n", "<=", "1"}], "||", 
     RowBox[{"n", ">=", "7"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"n", "==", "2"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Plot3D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "plotN"}], ",", "plotN"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "plotN"}], ",", "plotN"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "==", "3"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ContourPlot3D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "plotN"}], ",", "plotN"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"-", "plotN"}], ",", "plotN"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", 
            RowBox[{"-", "plotN"}], ",", "plotN"}], "}"}]}], " ", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
