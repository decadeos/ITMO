Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heavyBall", "[", 
     RowBox[{
     "func_", ",", "x0_", ",", "alpha_", ",", "beta_", ",", "maxIter_", ",", 
      "tol_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "x", ",", "xPrev", ",", "xNew", ",", "trajectory", ",", "iter", ",", 
        "grad", ",", "errors", ",", 
        RowBox[{"h", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "5"}]}]}], ",", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "x0", "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"numericGrad", "[", "x_", "]"}], ":=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"func", "[", 
              RowBox[{"x", "+", 
               RowBox[{"h", "*", 
                RowBox[{"UnitVector", "[", 
                 RowBox[{"n", ",", "i"}], "]"}]}]}], "]"}], "-", 
             RowBox[{"func", "[", 
              RowBox[{"x", "-", 
               RowBox[{"h", "*", 
                RowBox[{"UnitVector", "[", 
                 RowBox[{"n", ",", "i"}], "]"}]}]}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "h"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"xPrev", "=", "x0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"grad", "=", 
        RowBox[{"numericGrad", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"x0", "-", 
         RowBox[{"alpha", "*", "grad"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"trajectory", "=", 
        RowBox[{"{", 
         RowBox[{"xPrev", ",", "x"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"errors", "=", 
        RowBox[{"{", 
         RowBox[{"Norm", "[", "grad", "]"}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"iter", "=", "1"}], ",", 
         RowBox[{"iter", "<=", "maxIter"}], ",", 
         RowBox[{"iter", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"grad", "=", 
           RowBox[{"numericGrad", "[", "x", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"xNew", "=", 
           RowBox[{"x", "-", 
            RowBox[{"alpha", "*", "grad"}], "+", 
            RowBox[{"beta", "*", 
             RowBox[{"(", 
              RowBox[{"x", "-", "xPrev"}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"errors", ",", 
            RowBox[{"Norm", "[", "grad", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"trajectory", ",", "xNew"}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"xNew", "-", "x"}], "]"}], "<", "tol"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{
              "\"\<\:0414\:043e\:0441\:0442\:0438\:0433\:043d\:0443\:0442\
\:0430 \:0442\:043e\:0447\:043d\:043e\:0441\:0442\:044c! Iter: \>\"", ",", 
               " ", "iter"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Break", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"xPrev", "=", "x"}], ";", "\[IndentingNewLine]", 
          RowBox[{"x", "=", "xNew"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "trajectory", ",", "errors"}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1000", ",", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"alpha", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"beta", "=", "0.8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxIter", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tol", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]]}], ";"}]}], "Input",
 InitializationCell->True,
