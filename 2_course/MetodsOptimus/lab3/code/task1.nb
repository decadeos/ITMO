Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"heavyBall", "[", 
     RowBox[{
     "func_", ",", "gradFunc_", ",", "x0_", ",", "alpha_", ",", "beta_", ",", 
      "maxIter_", ",", "tol_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "x", ",", "xPrev", ",", "xNew", ",", "trajectory", ",", "iter", ",", 
        "grad", ",", 
        RowBox[{"shouldStop", "=", "False"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xPrev", "=", "x0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"grad", "=", 
        RowBox[{"gradFunc", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"x0", "-", 
         RowBox[{"alpha", "*", "grad"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"trajectory", "=", 
        RowBox[{"{", 
         RowBox[{"xPrev", ",", "x"}], "}"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"iter", "=", "1"}], ",", 
         RowBox[{
          RowBox[{"iter", "<=", "maxIter"}], "&&", 
          RowBox[{"!", "shouldStop"}]}], ",", 
         RowBox[{"iter", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"grad", "=", 
           RowBox[{"gradFunc", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"xNew", "=", 
           RowBox[{"x", "-", 
            RowBox[{"alpha", "*", "grad"}], "+", 
            RowBox[{"beta", "*", 
             RowBox[{"(", 
              RowBox[{"x", "-", "xPrev"}], ")"}]}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"xNew", "-", "x"}], "]"}], "<", "tol"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"shouldStop", "=", "True"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"trajectory", ",", "xNew"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"xPrev", "=", "x"}], ";", "\[IndentingNewLine]", 
          RowBox[{"x", "=", "xNew"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "trajectory"}], "}"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1000", ",", " ", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alpha", " ", "=", " ", 
   FractionBox["1", "20"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"beta", " ", "=", " ", 
   FractionBox["8", "10"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxIter", " ", "=", " ", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tol", " ", "=", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"result", " ", "=", " ", 
  RowBox[{"heavyBall", "[", 
   RowBox[{
   "f", ",", " ", "gradF", ",", " ", "x0", ",", " ", "alpha", ",", " ", 
    "beta", ",", " ", "maxIter", ",", " ", "tol"}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
