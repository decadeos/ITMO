Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"returnFunc", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "aRand", ",", "aSum", ",", "A", ",", "b", ",", "x", ",", "func", ",", 
       "gradFunc"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aRand", " ", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], " ", ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aSum", " ", "=", " ", 
       FractionBox[
        RowBox[{"(", " ", 
         RowBox[{"aRand", "+", 
          RowBox[{"Transpose", "[", "aRand", "]"}]}], ")"}], "2"]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A", " ", "=", 
       RowBox[{"aSum", "  ", "+", " ", 
        RowBox[{"3", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", " ", "=", "  ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"10", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Symbol", "[", 
           RowBox[{"\"\<x\>\"", "<>", 
            RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], ",", "n"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"func", "[", "vec_", "]"}], " ", ":=", " ", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", " "}]], " ", "+", " ", 
        RowBox[{
         RowBox[{"Transpose", "[", "vec", "]"}], ".", "A", ".", "vec"}], " ", 
        "-", 
        RowBox[{"b", ".", "vec"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gradFunc", " ", "=", " ", 
       RowBox[{"Grad", "[", 
        RowBox[{
         RowBox[{"func", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"func", ",", " ", "gradFunc"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotN", " ", "=", " ", "100"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", " ", "gradF"}], "}"}], " ", "=", " ", 
    RowBox[{"returnFunc", "[", "n", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"n", " ", "<=", " ", "1"}], " ", "||", " ", 
     RowBox[{"n", " ", ">=", " ", "7"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", " ", "==", " ", "2"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Plot3D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", 
          RowBox[{"-", "plotN"}], ",", " ", "plotN"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"y", ",", " ", 
          RowBox[{"-", "plotN"}], ",", " ", "plotN"}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"n", " ", "==", " ", "3"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ContourPlot3D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}], "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", 
            RowBox[{"-", "plotN"}], ",", " ", "plotN"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y", ",", " ", 
            RowBox[{"-", "plotN"}], ",", " ", "plotN"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"z", ",", " ", 
            RowBox[{"-", "plotN"}], ",", " ", "plotN"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
